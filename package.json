{
  "name": "plunge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plunge \u2014 a free, open source, mobile web Texas 42 game",
  "license": "CC0-1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/verify-walt.mjs",
    "dev:questions": "wrangler dev --port 8787",
    "questions": "node scripts/questions.mjs",
    "db:local": "wrangler d1 migrations apply QUESTIONS --local",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "onnxruntime-web": "^1.26.0",
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.4",
    "fake-indexeddb": "6.2.4",
    "fast-check": "^3.23.2",
    "miniflare": "4.20260507.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "4.90.0"
  }
}
